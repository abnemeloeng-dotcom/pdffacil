{"name": "PDFFácil", "short_name": "PDFFácil", "description": "Leitor de PDF simples, sem anúncios, que funciona offline.", "start_url": "./", "scope": "./", "display": "standalone", "background_color": "#14171a", "theme_color": "#14171a", "lang": "pt-BR", "icons": [{"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"}, {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}], "id": "./", "file_handlers": [{"action": "./", "accept": {"application/pdf": [".pdf"]}}], "share_target": {"action": "./share", "method": "POST", "enctype": "multipart/form-data", "params": {"files": [{"name": "pdf", "accept": ["application/pdf", ".pdf"]}]}}}